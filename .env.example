# Copy to .env.local (never commit it). Both values are PUBLIC client values.
# Supabase dashboard -> Project Settings -> API (URL) and API Keys (Publishable key, starts with sb_publishable_).
# Never put the secret / service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

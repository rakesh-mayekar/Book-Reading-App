# Copy to .env.local (never commit it). All values are PUBLIC client values.
# Supabase dashboard -> Project Settings -> API: Project URL, and the Publishable key (starts with sb_publishable_).
# Never put the secret / service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Optional. Must match your Supabase settings (defaults shown).
# Supabase -> Authentication -> Sign In / Providers -> Email -> "Email OTP Length"
VITE_OTP_LENGTH=6
# Supabase -> Authentication -> Rate Limits / Email -> "Minimum interval between emails per user" (seconds)
VITE_OTP_RESEND_SECONDS=60
